          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Mongo saudavel', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.expect(body.status).to.eql('healthy');",
