# Copie este arquivo para .env e preencha as chaves.
# cp .env.example .env

JWT_KEY=sua_chave_secreta_minimo_32_caracteres

# Sugestão de score por IA (Google Gemini). Opcional: sem a chave, o
# endpoint POST /api/Idea/{id}/ai-score responde 502 e a avaliação manual
# continua funcionando normalmente.
GEMINI_API_KEY=sua_chave_da_api_gemini
GEMINI_MODEL=gemini-3.5-flash-lite
